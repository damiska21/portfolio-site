---
import { accentColor, accentColorHover, backgroundColor, foregroundColor, accentColorHover2 } from "../lib/theme";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const siteLabel = pathname === "/" ? "/home/damiska $ ls ~/" : `/home/damiska${pathname} $ ls ~/`;

const links = [
    { href: "/", label: "Home" },
    { href: "/Projects", label: "Projects" },
    { href: "/Blog", label: "Blogs" },
];
---

<nav class="navbar" aria-label="Primary">
    <a class="navbar__brand" href="/">{siteLabel}</a>
    <div class="navbar__links" aria-label="Directory listing">
        {links.map((link) => (
            <a class:list={["navbar__link", pathname === link.href ? "is-active" : undefined]} href={link.href}>
                {link.label}
            </a>
        ))}
    </div>
</nav>

<style define:vars={{ accentColor, backgroundColor, foregroundColor, accentColorHover, accentColorHover2 }}>
    .navbar {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        background: var(--backgroundColor);
        border-bottom: 1px solid color-mix(in srgb, var(--accentColor) 45%, transparent);
        margin-left: 25px;
        margin-right: 25px;
    }

    .navbar__brand {
        color: var(--accentColor);
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .navbar__links {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-wrap: wrap;
        white-space: nowrap;
        padding-left: 1rem;
    }

    .navbar__link {
        color: var(--foregroundColor);
        text-decoration: none;
    }

    .navbar__link:hover {
        color: var(--accentColorHover);
    }
    .navbar__link.is-active {
        color: var(--accentColorHover2);
    }
</style>