---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { accentColor, backgroundColor, foregroundColor } from "../lib/theme";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const siteLabel = pathname === "/" ? "/home/damiska" : `/home/damiska${pathname}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{siteLabel}</title>
	</head>
	<body>
		<Navbar />
		<main class="content">
			<slot />
		</main>
		<Footer/>
	</body>
</html>

<style is:global define:vars={{ foregroundColor, backgroundColor, accentColor }}>
	@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap');
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background-color: var(--backgroundColor);
		color: var(--foregroundColor);
		font-family: "JetBrains Mono", monospace;
	}
	h1 {
		color: var(--accentColor);
	}
	.content {
		flex: 1;
		padding: 1rem 1.25rem;
		margin: 25px;
	}
</style>
